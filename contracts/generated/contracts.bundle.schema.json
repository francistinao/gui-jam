    "ErrorCode": {
      "enum": [
        "CONFLICT",
        "STALE_BASE",
        "PATH_DENIED",
        "NOT_EDITABLE",
        "INVALID_REQUEST",
        "UNKNOWN_CHANGESET",
        "UNKNOWN_ENTRY",
        "ALREADY_UNDONE",
        "CANCELLED",
        "PROVIDER_NOT_INSTALLED",
        "PROVIDER_NOT_AUTHENTICATED",
        "PROVIDER_RATE_LIMITED",
        "PROVIDER_INVALID_OUTPUT",
        "PROVIDER_TIMEOUT",
        "PROVIDER_FAILED",
        "PROVIDER_CRASHED",
        "PLUGIN_UNAVAILABLE",
        "DAEMON_UNAVAILABLE",
        "INTERNAL"

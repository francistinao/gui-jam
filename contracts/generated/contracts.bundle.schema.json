          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeChange"
          }
        }
      }
    },
    "GenerateDone": {
      "description": "The variants that survived validation, the first one previewed in the running app and none written yet; or, for a question, the answer.",
      "type": "object",
      "required": [
        "runId",
        "route",
        "summary",
        "elapsedMs",
        "variants",
        "dropped"
      ],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "summary": {
          "type": "string",
          "description": "One line for the terminal (F-DX-06, FR-050)."
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "variants": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/VariantPreview"
          }
        },
        "dropped": {
          "description": "Variants the model proposed that could not be applied, with the reason.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "update": {
          "$ref": "#/$defs/UpdateResult"
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "VariantSelect": {
      "description": "Show another variant of the run in place of the current one; the file on disk is untouched.",
      "type": "object",
      "required": [
        "runId",
        "changesetId"
      ],
      "additionalProperties": false,
      "properties": {

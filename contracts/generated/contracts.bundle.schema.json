    "GenerateRequest": {
      "description": "Ask the developer's provider CLI for variants of an element. runId names the run for generate.progress, variant.select, generate.discard and generate.cancel.",
      "type": "object",
      "required": [
        "runId",
        "file",
        "line",
        "column",
        "prompt"
      ],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "prompt": {
          "type": "string",
          "maxLength": 4000
        },
        "forceAi": {
          "type": "boolean",
          "description": "Ask the provider even when the prompt is an exact edit GUIJam can make itself."
        },
        "page": {
          "$ref": "#/$defs/PageOutline"
        }
      }
    },
    "PageOutline": {
      "description": "What the page around the request shows, collected by the widget: landmarks, headings, images, links and buttons with their source locations. Its text comes from the running app and is untrusted.",
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/PageItem"
          }
        }
      }
    },
    "PageItem": {
      "type": "object",
      "required": [
        "kind",
        "tag",
        "text",
        "box"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "landmark",
            "heading",
            "image",
            "link",
            "button"
          ]
        },
        "tag": {
          "type": "string",
          "maxLength": 40
        },
        "text": {
          "type": "string",
          "maxLength": 120
        },
        "region": {
          "type": "string",
          "maxLength": 40
        },
        "src": {
          "type": "string",
          "maxLength": 300,
          "description": "The element's data-gj-src."
        },
        "url": {
          "type": "string",
          "maxLength": 300,
          "description": "For images, the URL path the page loads it from."
        },
        "box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer"
          },
          "description": "x, y, width and height in CSS pixels of the viewport."
        }
      }
    },
    "GenerateProgress": {
      "description": "Pushed by the daemon while a run works, to the page that asked. Each message is the whole step list, so a lost one cannot leave it wrong.",
      "type": "object",
      "required": [
        "runId",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "state"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": [
                  "done",
                  "active",
                  "pending"
                ]
              }
            }
          }
        }
      }
    },
    "Route": {
      "description": "How a request was answered (PRD §12): R0 is an exact edit with no model; R1 and R2 ask the provider at the fast and standard tiers.",
      "type": "object",
      "required": [
        "tier"
      ],
      "additionalProperties": false,
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "R0",
            "R1",
            "R2"
          ]
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "notice": {
          "type": "string",
          "description": "Why the request took this route, when it is worth saying."
        }
      }
    },

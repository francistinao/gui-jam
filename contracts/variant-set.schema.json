{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "variant-set.schema.json",
  "title": "VariantSet",
  "description": "Provider output for a widget request: three variants of the change, or, when the request is a question, an answer and no variants. missing lists design properties the model could not read and did not invent.",
  "type": "object",
  "required": ["variants"],
  "additionalProperties": false,
  "properties": {
    "answer": {
      "type": "string",
      "maxLength": 4000,
      "description": "The answer when the request is a question; leave it out when proposing variants."
    },
    "variants": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/Variant"
      }
    }
  },
  "$defs": {
    "Variant": {
      "type": "object",
      "required": ["label", "system", "style", "rationale", "missing", "ops"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 40
        },
        "system": {
          "type": "string"
        },
        "style": {
          "type": "string",
          "maxLength": 40
        },
        "rationale": {
          "type": "string",
          "maxLength": 600
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "$ref": "edit-op.schema.json"
          }
        },
        "assets": {
          "type": "array",
          "maxItems": 4,
          "description": "Icons or illustrations this variant adds as files. GUIJam saves each one in the project assets folder as <name>.<format>, rendering webp from the svg.",
          "items": {
            "type": "object",
            "required": ["name", "format", "svg"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "maxLength": 40
              },
              "format": {
                "type": "string",
                "enum": ["svg", "webp"]
              },
              "svg": {
                "type": "string",
                "maxLength": 20000,
                "description": "Self-contained SVG markup with a viewBox; no scripts or external references."
              },
              "width": {
                "type": "integer",
                "minimum": 16,
                "maximum": 1024,
                "description": "For webp, the width in pixels to render at."
              }
            }
          }
        }
      }
    }
  }
}

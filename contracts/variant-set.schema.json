{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "variant-set.schema.json",
  "title": "VariantSet",
  "description": "Provider output for a widget generation request. missing lists design properties the model could not read and did not invent.",
  "type": "object",
  "required": ["variants"],
  "additionalProperties": false,
  "properties": {
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/Variant" }
    }
  },
  "$defs": {
    "Variant": {
      "type": "object",
      "required": ["label", "system", "style", "rationale", "missing", "ops"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "maxLength": 40 },
        "system": { "type": "string" },
        "style": { "type": "string", "maxLength": 40 },
        "rationale": { "type": "string", "maxLength": 600 },
        "missing": { "type": "array", "items": { "type": "string" } },
        "ops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": { "$ref": "edit-op.schema.json" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finetune.schema.json",
  "title": "FinetuneProps",
  "description": "The fine-tune panel's current tweaks for one element. Each set property replaces that style group's base-state tokens; omitted properties leave the source alone.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fill": { "$ref": "#/$defs/FillValue" },
    "radius": { "$ref": "#/$defs/RadiusValue" },
    "text": { "$ref": "#/$defs/TextValue" },
    "stroke": { "$ref": "#/$defs/StrokeValue" },
    "effects": { "$ref": "#/$defs/EffectsValue" },
    "opacity": {
      "description": "Element opacity in percent; 100 removes the opacity utility or style.",
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "layout": { "$ref": "#/$defs/LayoutValue" },
    "source": {
      "description": "A new value for the string that produced the element's text, at one of its found places.",
      "type": "object",
      "required": ["file", "line", "column", "value"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "value": { "type": "string" }
      }
    },
    "content": {
      "description": "New values for the element's plain text runs.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/TextEdit" }
    }
  },
  "$defs": {
    "TextEdit": {
      "type": "object",
      "required": ["run", "value"],
      "additionalProperties": false,
      "properties": {
        "run": { "type": "integer", "minimum": 0 },
        "value": { "type": "string" }
      }
    },
    "FillValue": {
      "oneOf": [
        {
          "title": "FillToken",
          "type": "object",
          "required": ["kind", "name"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "token" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "title": "FillHex",
          "type": "object",
          "required": ["kind", "hex", "opacity"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "hex" },
            "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "opacity": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        {
          "title": "FillNone",
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "none" }
          }
        }
      ]
    },
    "RadiusValue": {
      "oneOf": [
        {
          "title": "RadiusToken",
          "type": "object",
          "required": ["kind", "name"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "token" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "title": "RadiusPx",
          "type": "object",
          "required": ["kind", "px"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "px" },
            "px": { "type": "integer", "minimum": 0, "maximum": 999 }
          }
        },
        {
          "title": "RadiusFull",
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "full" }
          }
        }
      ]
    },
    "TextValue": {
      "description": "Typography. Only the given fields change; color uses the fill forms.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "family": {
          "description": "A theme font name: sans, serif, mono or a --font-* name.",
          "type": "string",
          "minLength": 1
        },
        "weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "size": {
          "description": "Font size in px.",
          "type": "number",
          "minimum": 1,
          "maximum": 999
        },
        "lineHeight": {
          "description": "Line height in px.",
          "type": "number",
          "minimum": 0,
          "maximum": 999
        },
        "letterSpacing": {
          "description": "Letter spacing in em.",
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "align": { "enum": ["left", "center", "right", "justify"] },
        "color": { "$ref": "#/$defs/FillValue" }
      }
    },
    "StrokeValue": {
      "oneOf": [
        {
          "title": "StrokeNone",
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "none" }
          }
        },
        {
          "title": "StrokeSet",
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "set" },
            "width": {
              "description": "Border width in px on every side.",
              "type": "integer",
              "minimum": 0,
              "maximum": 999
            },
            "style": { "enum": ["solid", "dashed", "dotted"] },
            "color": { "$ref": "#/$defs/FillValue" }
          }
        }
      ]
    },
    "EffectsValue": {
      "description": "Box shadows by kind. A kind that is left out stays as it is; none removes that kind.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drop": { "$ref": "#/$defs/ShadowValue" },
        "inner": { "$ref": "#/$defs/ShadowValue" }
      }
    },
    "ShadowValue": {
      "oneOf": [
        {
          "title": "ShadowNone",
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "none" }
          }
        },
        {
          "title": "ShadowToken",
          "type": "object",
          "required": ["kind", "name"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "token" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "title": "ShadowCustom",
          "type": "object",
          "required": ["kind", "x", "y", "blur", "spread", "hex", "opacity"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "custom" },
            "x": { "type": "number", "minimum": -999, "maximum": 999 },
            "y": { "type": "number", "minimum": -999, "maximum": 999 },
            "blur": { "type": "number", "minimum": 0, "maximum": 999 },
            "spread": { "type": "number", "minimum": -999, "maximum": 999 },
            "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "opacity": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        }
      ]
    },
    "LayoutValue": {
      "description": "Padding and gap in px. Only the given sides and axes change.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "padding": { "$ref": "#/$defs/PaddingValue" },
        "gap": { "$ref": "#/$defs/GapValue" }
      }
    },
    "PaddingValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": { "type": "number", "minimum": 0, "maximum": 999 },
        "right": { "type": "number", "minimum": 0, "maximum": 999 },
        "bottom": { "type": "number", "minimum": 0, "maximum": 999 },
        "left": { "type": "number", "minimum": 0, "maximum": 999 }
      }
    },
    "GapValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "row": { "type": "number", "minimum": 0, "maximum": 999 },
        "column": { "type": "number", "minimum": 0, "maximum": 999 }
      }
    }
  }
}

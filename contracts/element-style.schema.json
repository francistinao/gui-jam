{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "element-style.schema.json",
  "title": "ElementStyle",
  "description": "What the fine-tune panel knows about one JSX element, read from its source. classSource says how className is written: none (no className, one can be added), static (a literal), call (cn()/clsx(); the first literal is editable) or dynamic (not editable; use Ask AI). adapter says how fine-tune writes the change: tailwind edits className tokens, inline edits the style={{…}} object (elements that already use one, and projects without Tailwind), vuetify sets the color and rounded props of Vuetify components. styleSource says how style is written: none, object (a static object literal) or dynamic (not editable).",
  "type": "object",
  "required": [
    "file",
    "line",
    "column",
    "tag",
    "baseHash",
    "classSource",
    "tokens",
    "theme",
    "adapter",
    "styleSource"
  ],
  "additionalProperties": false,
  "properties": {
    "file": {
      "type": "string"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "column": {
      "type": "integer",
      "minimum": 1
    },
    "tag": {
      "type": "string"
    },
    "baseHash": {
      "$ref": "edit-op.schema.json#/$defs/ContentHash"
    },
    "classSource": {
      "enum": ["none", "static", "call", "dynamic"]
    },
    "tokens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StyleToken"
      }
    },
    "theme": {
      "$ref": "#/$defs/ThemeTokens"
    },
    "adapter": {
      "enum": ["tailwind", "inline", "vuetify"]
    },
    "styleSource": {
      "enum": ["none", "object", "dynamic"]
    },
    "content": {
      "description": "What the element holds between its tags, in order: plain text runs that fine-tune can edit, code such as {name} that only Ask AI can change, and child elements. An element with nothing between its tags has one empty text run. Absent for self-closing and void elements.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ContentPart"
      }
    }
  },
  "$defs": {
    "TextPlace": {
      "description": "Where a string that produced the element's text is written. line and column point at the string's first character (its quote, or the first letter of JSX text). label names it: a variable, <Component prop>, <Component> or a translation key.",
      "type": "object",
      "required": ["file", "line", "column", "label"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "label": { "type": "string" }
      }
    },
    "ContentPart": {
      "oneOf": [
        {
          "title": "TextPart",
          "type": "object",
          "description": "A plain text run as the page shows it: entities decoded and whitespace collapsed. run counts text runs only, from 0.",
          "required": ["kind", "run", "value"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "text" },
            "run": { "type": "integer", "minimum": 0 },
            "value": { "type": "string" }
          }
        },
        {
          "title": "CodePart",
          "type": "object",
          "description": "Text the element gets from code, as written in the source, cut to 80 characters.",
          "required": ["kind", "source"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "code" },
            "source": { "type": "string" }
          }
        },
        {
          "title": "FoundPart",
          "type": "object",
          "description": "Text the element renders from code, traced to the strings that produced it: a data structure, a prop or child where the component is used, or a translation file. value is what the page shows; code is the expression. One place can be edited directly; with several, the developer picks one.",
          "required": ["kind", "value", "code", "places"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "found" },
            "value": { "type": "string" },
            "code": { "type": "string" },
            "places": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/TextPlace" }
            }
          }
        },
        {
          "title": "ElementPart",
          "type": "object",
          "description": "A child element; tag is empty for a fragment.",
          "required": ["kind", "tag"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "const": "element" },
            "tag": { "type": "string" }
          }
        }
      ]
    },
    "StyleGroup": {
      "enum": ["fill", "radius", "stroke", "text", "effects", "opacity", "layout"]
    },
    "StyleToken": {
      "type": "object",
      "description": "One class token that belongs to a style group. editable is false for variant-prefixed tokens (hover:, md:) and for tokens that only apply under a condition.",
      "required": ["token", "group", "property", "variants", "editable"],
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string"
        },
        "group": {
          "$ref": "#/$defs/StyleGroup"
        },
        "property": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "themeToken": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "editable": {
          "type": "boolean"
        }
      }
    },
    "ThemeTokens": {
      "type": "object",
      "required": ["colors", "radii", "fonts", "textSizes", "shadows", "spacing"],
      "additionalProperties": false,
      "properties": {
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThemeColor"
          }
        },
        "radii": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThemeRadius"
          }
        },
        "fonts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "textSizes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThemeRadius"
          }
        },
        "shadows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThemeShadow"
          }
        },
        "spacing": {
          "description": "Pixels in one spacing step.",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "ThemeShadow": {
      "type": "object",
      "required": ["name", "value", "inset"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" },
        "inset": { "type": "boolean" }
      }
    },
    "ThemeColor": {
      "type": "object",
      "required": ["name", "value"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "ThemeRadius": {
      "type": "object",
      "required": ["name", "px"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "px": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "element-style.schema.json",
  "title": "ElementStyle",
  "description": "What the fine-tune panel knows about one JSX element, read from its source. classSource says how className is written: none (no className, one can be added), static (a literal), call (cn()/clsx(); the first literal is editable) or dynamic (not editable; use Ask AI). adapter says how fine-tune writes the change: tailwind edits className tokens, inline edits the style={{…}} object (elements that already use one, and projects without Tailwind), vuetify sets the color and rounded props of Vuetify components. styleSource says how style is written: none, object (a static object literal) or dynamic (not editable).",
  "type": "object",
  "required": [
    "file",
    "line",
    "column",
    "tag",
    "baseHash",
    "classSource",
    "tokens",
    "theme",
    "adapter",
    "styleSource"
  ],
  "additionalProperties": false,
  "properties": {
    "file": {
      "type": "string"
    },
    "line": {
      "type": "integer",
      "minimum": 1
    },
    "column": {
      "type": "integer",
      "minimum": 1
    },
    "tag": {
      "type": "string"
    },
    "baseHash": {
      "$ref": "edit-op.schema.json#/$defs/ContentHash"
    },
    "classSource": {
      "enum": ["none", "static", "call", "dynamic"]
    },
    "tokens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StyleToken"
      }
    },
    "theme": {
      "$ref": "#/$defs/ThemeTokens"
    },
    "adapter": {
      "enum": ["tailwind", "inline", "vuetify"]
    },
    "styleSource": {
      "enum": ["none", "object", "dynamic"]
    }
  },
  "$defs": {
    "StyleGroup": {
      "enum": ["fill", "radius", "stroke", "text", "effects", "opacity"]
    },
    "StyleToken": {
      "type": "object",
      "description": "One class token that belongs to a style group. editable is false for variant-prefixed tokens (hover:, md:) and for tokens that only apply under a condition.",
      "required": ["token", "group", "property", "variants", "editable"],
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string"
        },
        "group": {
          "$ref": "#/$defs/StyleGroup"
        },
        "property": {
          "type": "string"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "themeToken": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "editable": {
          "type": "boolean"
        }
      }
    },
    "ThemeTokens": {
      "type": "object",
      "required": ["colors", "radii"],
      "additionalProperties": false,
      "properties": {
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThemeColor"
          }
        },
        "radii": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThemeRadius"
          }
        }
      }
    },
    "ThemeColor": {
      "type": "object",
      "required": ["name", "value"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "ThemeRadius": {
      "type": "object",
      "required": ["name", "px"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "px": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}

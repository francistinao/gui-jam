{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ws-protocol.schema.json",
  "title": "GuijamMessage",
  "description": "One frame on the daemon WebSocket, between the Vite plugin and gjd. Browser requests reach the daemon through the plugin, over Vite's HMR channel.",
  "oneOf": [
    {
      "title": "PluginHelloMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "plugin.hello"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/PluginHello"
        }
      }
    },
    {
      "title": "HelloOkMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "hello.ok"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/HelloOk"
        }
      }
    },
    {
      "title": "TailwindRootsMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "tailwind.roots"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/TailwindRoots"
        }
      }
    },
    {
      "title": "OverlaySetMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "overlay.set"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/OverlaySet"
        }
      }
    },
    {
      "title": "OverlayClearMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "overlay.clear"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/OverlayClear"
        }
      }
    },
    {
      "title": "UpdateResultMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "update.result"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "update-result.schema.json"
        }
      }
    },
    {
      "title": "ElementInspectMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "element.inspect"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/SourceRef"
        }
      }
    },
    {
      "title": "ElementStyleMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "element.style"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "element-style.schema.json"
        }
      }
    },
    {
      "title": "FinetunePreviewMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "finetune.preview"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/FinetunePreview"
        }
      }
    },
    {
      "title": "FinetunePreviewedMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "finetune.previewed"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/FinetunePreviewed"
        }
      }
    },
    {
      "title": "ChangesetCommitMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "changeset.commit"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/ChangesetRef"
        }
      }
    },
    {
      "title": "CommitDoneMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "commit.done"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/CommitDone"
        }
      }
    },
    {
      "title": "ChangesetDiscardMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "changeset.discard"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/ChangesetRef"
        }
      }
    },
    {
      "title": "ChangesetDiscardedMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "changeset.discarded"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/ChangesetRef"
        }
      }
    },
    {
      "title": "JournalUndoMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "journal.undo"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/JournalRef"
        }
      }
    },
    {
      "title": "UndoDoneMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "undo.done"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/UndoDone"
        }
      }
    },
    {
      "title": "GenerateRequestMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "generate.request"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/GenerateRequest"
        }
      }
    },
    {
      "title": "GenerateDoneMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "generate.done"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/GenerateDone"
        }
      }
    },
    {
      "title": "GenerateCancelMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "generate.cancel"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/RunRef"
        }
      }
    },
    {
      "title": "GenerateCancelledMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "generate.cancelled"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/RunRef"
        }
      }
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "generate.progress"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/GenerateProgress"
        }
      }
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "variant.select"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/VariantSelect"
        }
      }
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "variant.selected"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/VariantSelected"
        }
      }
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "generate.discard"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/RunRef"
        }
      }
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "generate.discarded"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/RunRef"
        }
      }
    },
    {
      "title": "ErrorMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/ErrorPayload"
        }
      }
    }
  ],
  "$defs": {
    "PluginHello": {
      "type": "object",
      "required": ["pluginVersion", "viteVersion", "root", "tailwindRoots"],
      "additionalProperties": false,
      "properties": {
        "pluginVersion": {
          "type": "string"
        },
        "viteVersion": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "tailwindRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Absolute paths of stylesheets that import Tailwind."
        }
      }
    },
    "HelloOk": {
      "type": "object",
      "required": ["daemonVersion"],
      "additionalProperties": false,
      "properties": {
        "daemonVersion": {
          "type": "string"
        }
      }
    },
    "TailwindRoots": {
      "type": "object",
      "required": ["files"],
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "OverlaySet": {
      "description": "Serve content in place of a project file (path relative to the project root).",
      "type": "object",
      "required": ["file", "content"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "OverlayClear": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        }
      }
    },
    "SourceRef": {
      "description": "An element's data-gj-src position.",
      "type": "object",
      "required": ["file", "line", "column"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "FinetunePreview": {
      "type": "object",
      "required": ["file", "line", "column", "props"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "props": {
          "$ref": "finetune.schema.json"
        }
      }
    },
    "CodeChange": {
      "description": "One changed hunk: the lines starting at line (1-based, in the current file) and what replaces them.",
      "type": "object",
      "required": ["file", "line", "before", "after"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "before": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "FinetunePreviewed": {
      "type": "object",
      "required": ["changesetId", "update", "changes"],
      "additionalProperties": false,
      "properties": {
        "changesetId": {
          "type": "string"
        },
        "update": {
          "$ref": "update-result.schema.json"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeChange"
          }
        }
      }
    },
    "ChangesetRef": {
      "type": "object",
      "required": ["changesetId"],
      "additionalProperties": false,
      "properties": {
        "changesetId": {
          "type": "string"
        }
      }
    },
    "CommitDone": {
      "type": "object",
      "required": ["journalId", "files", "summary"],
      "additionalProperties": false,
      "properties": {
        "journalId": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "JournalRef": {
      "type": "object",
      "required": ["journalId"],
      "additionalProperties": false,
      "properties": {
        "journalId": {
          "type": "string"
        }
      }
    },
    "UndoDone": {
      "type": "object",
      "required": ["journalId", "undoOf"],
      "additionalProperties": false,
      "properties": {
        "journalId": {
          "type": "string"
        },
        "undoOf": {
          "type": "string"
        }
      }
    },
    "GenerateRequest": {
      "description": "Ask the developer's provider CLI for variants of an element. runId names the run for generate.progress, variant.select, generate.discard and generate.cancel.",
      "type": "object",
      "required": ["runId", "file", "line", "column", "prompt"],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "prompt": {
          "type": "string",
          "maxLength": 4000
        },
        "forceAi": {
          "type": "boolean",
          "description": "Ask the provider even when the prompt is an exact edit GUIJam can make itself."
        },
        "page": {
          "$ref": "#/$defs/PageOutline"
        },
        "sketch": {
          "$ref": "#/$defs/Sketch"
        }
      }
    },
    "PageOutline": {
      "description": "What the page around the request shows, collected by the widget: landmarks, headings, images, links and buttons with their source locations. Its text comes from the running app and is untrusted.",
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/PageItem"
          }
        }
      }
    },
    "PageItem": {
      "type": "object",
      "required": ["kind", "tag", "text", "box"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["landmark", "heading", "image", "link", "button"]
        },
        "tag": {
          "type": "string",
          "maxLength": 40
        },
        "text": {
          "type": "string",
          "maxLength": 120
        },
        "region": {
          "type": "string",
          "maxLength": 40
        },
        "src": {
          "type": "string",
          "maxLength": 300,
          "description": "The element's data-gj-src."
        },
        "url": {
          "type": "string",
          "maxLength": 300,
          "description": "For images, the URL path the page loads it from."
        },
        "box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer"
          },
          "description": "x, y, width and height in CSS pixels of the viewport."
        }
      }
    },
    "Sketch": {
      "description": "Strokes the developer drew where no single element was meant, with images of the page and of the sketch.",
      "type": "object",
      "required": ["images", "box", "touching"],
      "additionalProperties": false,
      "properties": {
        "images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/SketchImage"
          }
        },
        "box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer"
          },
          "description": "x, y, width and height of the sketch in CSS pixels of the viewport."
        },
        "touching": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "The data-gj-src of annotated elements the sketch overlaps, at most 20."
        }
      }
    },
    "SketchImage": {
      "type": "object",
      "required": ["mediaType", "base64"],
      "additionalProperties": false,
      "properties": {
        "mediaType": {
          "type": "string",
          "enum": ["image/png", "image/jpeg"]
        },
        "base64": {
          "type": "string",
          "maxLength": 8000000
        }
      }
    },
    "GenerateProgress": {
      "description": "Pushed by the daemon while a run works, to the page that asked. Each message is the whole step list, so a lost one cannot leave it wrong.",
      "type": "object",
      "required": ["runId", "steps"],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "state"],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": ["done", "active", "pending"]
              }
            }
          }
        }
      }
    },
    "Route": {
      "description": "How a request was answered (PRD §12): R0 is an exact edit with no model; R1 and R2 ask the provider at the fast and standard tiers.",
      "type": "object",
      "required": ["tier"],
      "additionalProperties": false,
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["R0", "R1", "R2"]
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "notice": {
          "type": "string",
          "description": "Why the request took this route, when it is worth saying."
        }
      }
    },
    "VariantPreview": {
      "description": "One variant held as a changeset; variant.select shows it, changeset.commit writes it.",
      "type": "object",
      "required": ["changesetId", "label", "system", "style", "rationale", "file", "changes"],
      "additionalProperties": false,
      "properties": {
        "changesetId": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeChange"
          }
        }
      }
    },
    "GenerateDone": {
      "description": "The variants that survived validation, the first one previewed in the running app and none written yet; or, for a question, the answer.",
      "type": "object",
      "required": ["runId", "route", "summary", "elapsedMs", "variants", "dropped"],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "summary": {
          "type": "string",
          "description": "One line for the terminal (F-DX-06, FR-050)."
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "variants": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/VariantPreview"
          }
        },
        "dropped": {
          "description": "Variants the model proposed that could not be applied, with the reason.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reason"],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "update": {
          "$ref": "update-result.schema.json"
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "VariantSelect": {
      "description": "Show another variant of the run in place of the current one; the file on disk is untouched.",
      "type": "object",
      "required": ["runId", "changesetId"],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },

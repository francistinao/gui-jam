{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ws-protocol.schema.json",
  "title": "GuijamMessage",
  "description": "One frame on the daemon WebSocket, between the Vite plugin and gjd. Browser requests reach the daemon through the plugin, over Vite's HMR channel.",
  "oneOf": [
    {
      "title": "PluginHelloMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "plugin.hello"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/PluginHello"
        }
      }
    },
    {
      "title": "HelloOkMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "hello.ok"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/HelloOk"
        }
      }
    },
    {
      "title": "TailwindRootsMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "tailwind.roots"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/TailwindRoots"
        }
      }
    },
    {
      "title": "OverlaySetMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "overlay.set"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/OverlaySet"
        }
      }
    },
    {
      "title": "OverlayClearMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "overlay.clear"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/OverlayClear"
        }
      }
    },
    {
      "title": "UpdateResultMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "update.result"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "update-result.schema.json"
        }
      }
    },
    {
      "title": "ElementInspectMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "element.inspect"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/SourceRef"
        }
      }
    },
    {
      "title": "ElementStyleMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "element.style"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "element-style.schema.json"
        }
      }
    },
    {
      "title": "FinetunePreviewMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "finetune.preview"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/FinetunePreview"
        }
      }
    },
    {
      "title": "FinetunePreviewedMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "finetune.previewed"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/FinetunePreviewed"
        }
      }
    },
    {
      "title": "ChangesetCommitMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "changeset.commit"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/ChangesetRef"
        }
      }
    },
    {
      "title": "CommitDoneMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "commit.done"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/CommitDone"
        }
      }
    },
    {
      "title": "ChangesetDiscardMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "changeset.discard"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/ChangesetRef"
        }
      }
    },
    {
      "title": "ChangesetDiscardedMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "changeset.discarded"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/ChangesetRef"
        }
      }
    },
    {
      "title": "JournalUndoMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "journal.undo"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/JournalRef"
        }
      }
    },
    {
      "title": "UndoDoneMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "undo.done"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/UndoDone"
        }
      }
    },
    {
      "title": "GenerateRequestMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "generate.request"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/GenerateRequest"
        }
      }
    },
    {
      "title": "GenerateDoneMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "generate.done"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/GenerateDone"
        }
      }
    },
    {
      "title": "GenerateCancelMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "generate.cancel"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/RunRef"
        }
      }
    },
    {
      "title": "GenerateCancelledMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "generate.cancelled"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/RunRef"
        }
      }
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "generate.progress"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/GenerateProgress"
        }
      }
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "variant.select"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/VariantSelect"
        }
      }
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "variant.selected"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/VariantSelected"
        }
      }
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "dependencies.install"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/DependenciesInstall"
        }
      }
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "dependencies.installed"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/DependenciesInstalled"
        }
      }
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "generate.discard"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/RunRef"
        }
      }
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "generate.discarded"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/RunRef"
        }
      }
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "generate.attach"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/GenerateAttach"
        }
      }
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "preview.release"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/PreviewRelease"
        }
      }
    },
    {
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "preview.released"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/PreviewRelease"
        }
      }
    },
    {
      "title": "ErrorMessage",
      "type": "object",
      "required": ["type", "payload"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "id": {
          "type": "string",
          "description": "Set on requests; a reply repeats its request's id."
        },
        "payload": {
          "$ref": "#/$defs/ErrorPayload"
        }
      }
    }
  ],
  "$defs": {
    "PluginHello": {
      "type": "object",
      "required": ["pluginVersion", "viteVersion", "root", "tailwindRoots"],
      "additionalProperties": false,
      "properties": {
        "pluginVersion": {
          "type": "string"
        },
        "viteVersion": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "tailwindRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Absolute paths of stylesheets that import Tailwind."
        }
      }
    },
    "HelloOk": {
      "type": "object",
      "required": ["daemonVersion"],
      "additionalProperties": false,
      "properties": {
        "daemonVersion": {
          "type": "string"
        }
      }
    },
    "TailwindRoots": {
      "type": "object",
      "required": ["files"],
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "OverlaySet": {
      "description": "Serve content in place of a project file (path relative to the project root).",
      "type": "object",
      "required": ["file", "content"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "pageReload": {
          "type": "boolean",
          "description": "Server-rendered templates (.astro) can't be hot-reloaded. When true or absent, the plugin reloads the page to show the change; false leaves the page alone because the widget patches it in place."
        }
      }
    },
    "OverlayClear": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "pageReload": {
          "type": "boolean",
          "description": "Server-rendered templates (.astro) can't be hot-reloaded. When true or absent, the plugin reloads the page to show the change; false leaves the page alone because the widget patches it in place."
        }
      }
    },
    "SourceRef": {
      "description": "An element's data-gj-src position.",
      "type": "object",
      "required": ["file", "line", "column"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "FinetunePreview": {
      "type": "object",
      "required": ["file", "line", "column", "props"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "props": {
          "$ref": "finetune.schema.json"
        }
      }
    },
    "CodeChange": {
      "description": "One changed hunk: the lines starting at line (1-based, in the current file) and what replaces them.",
      "type": "object",
      "required": ["file", "line", "before", "after"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "before": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "after": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "FinetunePreviewed": {
      "type": "object",
      "required": ["changesetId", "update", "changes"],
      "additionalProperties": false,
      "properties": {
        "changesetId": {
          "type": "string"
        },
        "update": {
          "$ref": "update-result.schema.json"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeChange"
          }
        },
        "dom": {
          "$ref": "#/$defs/DomPatch"
        }
      }
    },
    "ChangesetRef": {
      "type": "object",
      "required": ["changesetId"],
      "additionalProperties": false,
      "properties": {
        "changesetId": {
          "type": "string"
        }
      }
    },
    "CommitDone": {
      "type": "object",
      "required": ["journalId", "files", "summary"],
      "additionalProperties": false,
      "properties": {
        "journalId": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "JournalRef": {
      "type": "object",
      "required": ["journalId"],
      "additionalProperties": false,
      "properties": {
        "journalId": {
          "type": "string"
        }
      }
    },
    "UndoDone": {
      "type": "object",
      "required": ["journalId", "undoOf"],
      "additionalProperties": false,
      "properties": {
        "journalId": {
          "type": "string"
        },
        "undoOf": {
          "type": "string"
        }
      }
    },
    "GenerateRequest": {
      "description": "Ask the developer's provider CLI for variants of an element. runId names the run for generate.progress, variant.select, generate.discard and generate.cancel.",
      "type": "object",
      "required": ["runId", "file", "line", "column", "prompt"],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        },
        "prompt": {
          "type": "string",
          "maxLength": 4000
        },
        "forceAi": {
          "type": "boolean",
          "description": "Ask the provider even when the prompt is an exact edit GUIJam can make itself."
        },
        "page": {
          "$ref": "#/$defs/PageOutline"
        },
        "sketch": {
          "$ref": "#/$defs/Sketch"
        },
        "attachments": {
          "$ref": "#/$defs/Attachments"
        }
      }
    },
    "PageOutline": {
      "description": "What the page around the request shows, collected by the widget: landmarks, headings, images, links and buttons with their source locations. Its text comes from the running app and is untrusted.",
      "type": "object",
      "required": ["items"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/PageItem"
          }
        }
      }
    },
    "PageItem": {
      "type": "object",
      "required": ["kind", "tag", "text", "box"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["landmark", "heading", "image", "link", "button"]
        },
        "tag": {
          "type": "string",
          "maxLength": 40
        },
        "text": {
          "type": "string",
          "maxLength": 120
        },
        "region": {
          "type": "string",
          "maxLength": 40
        },
        "src": {
          "type": "string",
          "maxLength": 300,
          "description": "The element's data-gj-src."
        },
        "url": {
          "type": "string",
          "maxLength": 300,
          "description": "For images, the URL path the page loads it from."
        },
        "box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer"
          },
          "description": "x, y, width and height in CSS pixels of the viewport."
        }
      }
    },
    "Sketch": {
      "description": "Strokes the developer drew, with images of the page and of the sketch. Without elementBox they were drawn where no single element was meant; with it, over an element the developer selected.",
      "type": "object",
      "required": ["images", "box", "touching"],
      "additionalProperties": false,
      "properties": {
        "images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/SketchImage"
          }
        },
        "box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer"
          },
          "description": "x, y, width and height of the sketch in CSS pixels of the viewport."
        },
        "touching": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300
          },
          "description": "The data-gj-src of annotated elements the sketch overlaps, at most 20."
        },
        "captureMs": {
          "description": "How long the widget took to capture the sketch images.",
          "type": "integer",
          "minimum": 0
        },
        "elementBox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer"
          },
          "description": "Set when the developer selected the element and sketched over it: its x, y, width and height in CSS pixels of the viewport. The strokes then show what the developer wants for that element, not new UI."
        }
      }
    },
    "Attachments": {
      "description": "What the developer attached to the prompt for inspiration.",
      "type": "object",
      "required": ["images"],
      "additionalProperties": false,
      "properties": {
        "images": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/InspirationImage"
          }
        }
      }
    },
    "InspirationImage": {
      "description": "An image the developer attached, re-encoded in the browser to at most 1568 px on its longest side.",
      "type": "object",
      "required": ["mediaType", "base64"],
      "additionalProperties": false,
      "properties": {
        "mediaType": {
          "type": "string",
          "enum": ["image/png", "image/jpeg", "image/webp"]
        },
        "base64": {
          "type": "string",
          "maxLength": 4000000
        }
      }
    },
    "SketchImage": {
      "type": "object",
      "required": ["mediaType", "base64"],
      "additionalProperties": false,
      "properties": {
        "mediaType": {
          "type": "string",
          "enum": ["image/png", "image/jpeg"]
        },
        "base64": {
          "type": "string",
          "maxLength": 8000000
        }
      }
    },
    "GenerateProgress": {
      "description": "Pushed by the daemon while a run works, to the page that asked. Each message is the whole step list, so a lost one cannot leave it wrong.",
      "type": "object",
      "required": ["runId", "steps"],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "timeoutMs": {
          "description": "How long the run may take in total before it stops with a timeout.",
          "type": "integer",
          "minimum": 0
        },
        "variants": {
          "description": "Variants that already arrived, in the order they arrived; each is held as a changeset and can be selected or committed before the run ends.",
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/VariantPreview"
          }
        },
        "waiting": {
          "description": "How many variants are still being written.",
          "type": "integer",
          "minimum": 0
        },
        "expectedMs": {
          "description": "Median wait for the first variant over this project's recent runs with the same AI tool, model and tier, counted from the developer pressing Generate. Absent until there are three such runs.",
          "type": "integer",
          "minimum": 0
        },
        "update": {
          "description": "Set once the first variant that arrived is previewed in the running app.",
          "$ref": "update-result.schema.json"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "state"],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "state": {
                "type": "string",
                "enum": ["done", "active", "pending"]
              },
              "detail": {
                "description": "What the active step is doing right now, such as the AI tool starting, thinking, writing or retrying.",
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "Route": {
      "description": "How a request was answered (PRD §12): R0 is an exact edit with no model; R1 and R2 ask the provider at the fast and standard tiers.",
      "type": "object",
      "required": ["tier"],
      "additionalProperties": false,
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["R0", "R1", "R2"]
        },
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "notice": {
          "type": "string",
          "description": "Why the request took this route, when it is worth saying."
        }
      }
    },
    "VariantPreview": {
      "description": "One variant held as a changeset; variant.select shows it, changeset.commit writes it.",
      "type": "object",
      "required": [
        "changesetId",
        "label",
        "system",
        "style",
        "rationale",
        "file",
        "changes",
        "created"
      ],
      "additionalProperties": false,
      "properties": {
        "changesetId": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "system": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeChange"
          }
        },
        "created": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Files this variant adds, such as generated icons."
        },
        "needs": {
          "$ref": "#/$defs/DependencyNeeds"
        }
      }
    },
    "GenerateDone": {
      "description": "The variants that survived validation, the first one previewed in the running app and none written yet; or, for a question, the answer.",
      "type": "object",
      "required": ["runId", "route", "summary", "elapsedMs", "variants", "dropped"],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "route": {
          "$ref": "#/$defs/Route"
        },
        "summary": {
          "type": "string",
          "description": "One line for the terminal (F-DX-06, FR-050)."
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "variants": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/VariantPreview"
          }
        },
        "notes": {
          "description": "Context GUIJam could not gather, such as a link that did not load. The run still answered.",
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "dropped": {
          "description": "Variants the model proposed that could not be applied, with the reason.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["reason"],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "update": {
          "$ref": "update-result.schema.json"
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "VariantSelect": {
      "description": "Show another variant of the run in place of the current one; the file on disk is untouched.",
      "type": "object",
      "required": ["runId", "changesetId"],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "changesetId": {
          "type": "string"
        }
      }
    },
    "VariantSelected": {
      "type": "object",
      "required": ["changesetId", "update"],
      "additionalProperties": false,
      "properties": {
        "changesetId": {
          "type": "string"
        },
        "update": {
          "$ref": "update-result.schema.json"
        }
      }
    },
    "RunRef": {
      "type": "object",
      "required": ["runId"],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        }
      }
    },
    "ErrorCode": {
      "enum": [
        "CONFLICT",
        "STALE_BASE",
        "PATH_DENIED",
        "NOT_EDITABLE",
        "INVALID_REQUEST",
        "UNKNOWN_CHANGESET",
        "UNKNOWN_ENTRY",
        "ALREADY_UNDONE",
        "CANCELLED",
        "PROVIDER_NOT_INSTALLED",
        "PROVIDER_NOT_AUTHENTICATED",
        "PROVIDER_RATE_LIMITED",
        "PROVIDER_INVALID_OUTPUT",
        "PROVIDER_TIMEOUT",
        "PROVIDER_FAILED",
        "PROVIDER_CRASHED",
        "PLUGIN_UNAVAILABLE",
        "DAEMON_UNAVAILABLE",
        "INTERNAL"
      ]
    },
    "ErrorPayload": {
      "description": "PRD §19.6: what went wrong and what the developer can do next.",
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "action": {
          "type": "string"
        }
      }
    },
    "Package": {
      "description": "An npm package at an exact version.",
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 214
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "DependencyNeeds": {
      "description": "Libraries a variant imports that the project hasn't installed. The variant isn't previewed until they are.",
      "type": "object",
      "required": ["command", "packages"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "maxLength": 500,
          "description": "The install command GUIJam runs in the project, shown to the developer."
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/Package"
          }
        }
      }
    },
    "DependenciesInstall": {
      "description": "Install what a held variant needs, then preview it. Sent only after the developer chose Install and preview.",
      "type": "object",
      "required": ["runId", "changesetId"],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        },
        "changesetId": {
          "type": "string"
        }
      }
    },
    "DependenciesInstalled": {
      "type": "object",
      "required": ["changesetId", "installed", "update"],
      "additionalProperties": false,
      "properties": {
        "changesetId": {
          "type": "string"
        },
        "installed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Package"
          }
        },
        "update": {
          "$ref": "update-result.schema.json"
        }
      }
    },
    "GenerateAttach": {
      "description": "Widget to plugin only: after the page reloads, wait for a run the page started before it and reply with its generate.done or error. The plugin answers it; the daemon never sees it.",
      "type": "object",
      "required": ["runId"],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        }
      }
    },
    "PreviewRelease": {
      "description": "Plugin to daemon: the page that started this run went away. If the run holds the preview, put the files back and free the preview; keep the run's variants in case the page comes back.",
      "type": "object",
      "required": ["runId"],
      "additionalProperties": false,
      "properties": {
        "runId": {
          "type": "string"
        }
      }
    },
    "DomPatch": {
      "description": "Shows a fine-tune preview of a server-rendered template in the page without reloading it: the widget changes the class and style attributes of every element with this source location.",
      "type": "object",
      "required": ["src", "addClasses", "removeClasses", "setStyles", "removeStyles"],
      "additionalProperties": false,
      "properties": {
        "src": {
          "type": "string",
          "minLength": 1,
          "description": "The data-gj-src value of the elements to change."
        },
        "addClasses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removeClasses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "setStyles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["property", "value"],
            "additionalProperties": false,
            "properties": {
              "property": {
                "type": "string",
                "description": "A CSS property name, kebab-case."
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "removeStyles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

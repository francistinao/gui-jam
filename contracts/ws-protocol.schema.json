        "STALE_BASE",
        "PATH_DENIED",
        "NOT_EDITABLE",
        "INVALID_REQUEST",
        "UNKNOWN_CHANGESET",
        "UNKNOWN_ENTRY",
        "ALREADY_UNDONE",
        "CANCELLED",

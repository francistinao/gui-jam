{
  "name": "guijam",
  "version": "0.0.0",
  "description": "Draw on your running Vite app, get live UI variants from your own LLM CLI, and write minimal source edits.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "guijam": "./dist/cli.js"
  },
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "default": "./dist/nuxt.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/npm-readme.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "magic-string": "1.4.5",
    "oxc-parser": "0.157.0"
  },
  "devDependencies": {
    "@guijam/contracts-ts": "workspace:*",
    "@guijam/vite-plugin": "workspace:*",
    "@types/node": "22.20.5",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}

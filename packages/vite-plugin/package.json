{
  "name": "@guijam/vite-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./daemon-binary": {
      "types": "./dist/daemon-binary.d.ts",
      "default": "./dist/daemon-binary.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.client.json && cp ../overlay/dist/widget.js dist/widget.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@guijam/contracts-ts": "workspace:*",
    "@guijam/overlay": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "lucide": "1.67.0",
    "magic-string": "1.4.5",
    "oxc-parser": "0.159.0"
  }
}

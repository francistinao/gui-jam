{
  "name": "@guijam/vite-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./daemon-binary": {
      "types": "./dist/daemon-binary.d.ts",
      "default": "./dist/daemon-binary.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./next/client": "./dist/next-client.js",
    "./next/loader": {
      "types": "./dist/next-loader.d.ts",
      "default": "./dist/next-loader.js"
    },
    "./next/version": {
      "types": "./dist/next-version.d.ts",
      "default": "./dist/next-version.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.client.json && cp ../overlay/dist/widget.js dist/widget.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.5.2",
    "@guijam/contracts-ts": "workspace:*",
    "@guijam/overlay": "workspace:*",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "svelte": "5.57.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vue": "3.5.44"
  },
  "dependencies": {
    "lucide": "1.66.0",
    "magic-string": "1.4.5",
    "oxc-parser": "0.157.0",
    "ws": "8.22.1"
  }
}
